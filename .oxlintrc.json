{
  "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["dist", "storybook-static"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**"],
                "message": "FSD: shared는 다른 계층을 가져올 수 없습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**"],
                "message": "FSD: entities는 shared만 가져올 수 있습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/*/**"],
                "message": "FSD: features는 아래 계층의 공개 API만 가져올 수 있습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/*/**", "@/entities/*/**"],
                "message": "FSD: widgets는 아래 계층의 공개 API만 가져올 수 있습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/pages/**", "@/widgets/*/**", "@/features/*/**", "@/entities/*/**"],
                "message": "FSD: pages는 아래 계층의 공개 API만 가져올 수 있습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/pages/*/**", "@/widgets/*/**", "@/features/*/**", "@/entities/*/**"],
                "message": "FSD: 슬라이스는 공개 API로만 가져옵니다."
              }
            ]
          }
        ]
      }
    }
  ]
}
